generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum CenterUserRole {
  OWNER
  MANAGER
}

model Student {
  id           String   @id @default(uuid())
  first_name   String?
  last_name    String?
  email        String?  @unique
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  last_seen_at DateTime @default(now())

  password_hash              String?
  email_verified             Boolean   @default(false)
  email_verification_token   String?
  email_verification_expires DateTime?
  password_reset_token       String?
  password_reset_expires     DateTime?

  device_sessions DeviceSession[]
  exam_sessions   ExamSession[]
  lesen_sessions  LesenSession[]
  oauth_accounts  OAuthAccount[]

  @@index([email])
  @@map("students")
}

model OAuthAccount {
  id          String   @id @default(uuid())
  student_id  String
  provider    String
  provider_id String
  created_at  DateTime @default(now())

  student Student @relation(fields: [student_id], references: [id])

  @@unique([provider, provider_id])
  @@index([student_id])
  @@map("oauth_accounts")
}

model DeviceSession {
  id                 String    @id @default(uuid())
  student_id         String
  device_id          String
  refresh_token_hash String
  device_name        String?
  last_used_at       DateTime  @default(now())
  created_at         DateTime  @default(now())
  revoked_at         DateTime?

  student Student @relation(fields: [student_id], references: [id])

  @@unique([student_id, device_id])
  @@index([student_id])
  @@map("device_sessions")
}

model Center {
  id         String   @id @default(uuid())
  name       String
  country    String
  city       String
  logo_url   String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  users CenterUser[]

  @@map("centers")
}

model CenterUser {
  id           String         @id @default(uuid())
  center_id    String
  role         CenterUserRole @default(OWNER)
  first_name   String
  last_name    String
  email        String         @unique
  phone        String
  created_at   DateTime       @default(now())
  updated_at   DateTime       @default(now()) @updatedAt
  last_seen_at DateTime       @default(now())

  password_hash              String
  email_verified             Boolean   @default(false)
  email_verification_token   String?
  email_verification_expires DateTime?
  password_reset_token       String?
  password_reset_expires     DateTime?

  center          Center                @relation(fields: [center_id], references: [id], onDelete: Restrict)
  device_sessions CenterDeviceSession[]

  @@index([center_id])
  @@index([email_verification_token])
  @@index([password_reset_token])
  @@map("center_users")
}

model CenterDeviceSession {
  id                 String    @id @default(uuid())
  center_user_id     String
  device_id          String
  refresh_token_hash String
  device_name        String?
  last_used_at       DateTime  @default(now())
  created_at         DateTime  @default(now())
  revoked_at         DateTime?

  center_user CenterUser @relation(fields: [center_user_id], references: [id], onDelete: Cascade)

  @@unique([center_user_id, device_id])
  @@index([center_user_id])
  @@map("center_device_sessions")
}

model ExamSession {
  session_id                 String    @id @default(uuid())
  user_id                    String?
  student_id                 String?
  teil_number                Int
  status                     String
  use_timer                  Boolean?  @default(true)
  time_limit_seconds         Int?
  server_start_time          DateTime?
  pause_timestamp            DateTime?
  elapsed_time               Int?      @default(0)
  context_from_previous_teil Boolean?  @default(false)
  created_at                 DateTime? @default(now())
  updated_at                 DateTime? @default(now())
  completed_at               DateTime?

  student          Student?         @relation(fields: [student_id], references: [id])
  teil_transcripts TeilTranscript[]
  teil_evaluations TeilEvaluation[]
  gemini_sessions  GeminiSession[]

  @@map("exam_sessions")
}

model GeminiSession {
  id                String    @id @default(uuid())
  exam_session_id   String
  gemini_session_id String?
  status            String?
  created_at        DateTime? @default(now())
  closed_at         DateTime?
  error_message     String?

  exam_session ExamSession @relation(fields: [exam_session_id], references: [session_id])

  @@map("gemini_sessions")
}

model TeilTranscript {
  id                   String    @id @default(uuid())
  session_id           String
  transcript_text      String
  conversation_history Json?
  word_count           Int?      @default(0)
  interrupted_at       DateTime?
  created_at           DateTime? @default(now())

  exam_session ExamSession @relation(fields: [session_id], references: [session_id])

  @@map("teil_transcripts")
}

model TeilEvaluation {
  id                      String    @id @default(uuid())
  session_id              String
  pronunciation_score     Float?
  fluency_score           Float?
  grammar_score           Float?
  vocabulary_score        Float?
  overall_score           Float?
  corrections_json        Json?
  strengths               String?
  areas_for_improvement   String?
  evaluation_requested_at DateTime?
  created_at              DateTime? @default(now())

  exam_session ExamSession @relation(fields: [session_id], references: [session_id])

  @@map("teil_evaluations")
}

model WritingAttempt {
  attempt_id        String    @id @default(uuid())
  student_id        String
  exercise_id       String
  modelltest_id     String?   @db.Uuid
  content           String
  status            String    @default("pending")
  score             Int?
  feedback          String?
  corrected_text    String?
  corrections       Json?
  diff              Json?
  points_addressed  Int?
  duration_seconds  Int?
  notification_sent Boolean   @default(false)
  created_at        DateTime  @default(now())
  completed_at      DateTime?

  @@map("writing_attempts")
}

model ListeningAttempt {
  attempt_id       String    @id @default(uuid())
  student_id       String
  exercise_id      String
  status           String    @default("completed")
  score            Int?
  feedback         String?
  duration_seconds Int?
  content_revision String?
  timed            Boolean?
  created_at       DateTime  @default(now())
  completed_at     DateTime?

  // Column only, no relation — matches WritingAttempt and SprachbausteineAttempt.
  // Nullable on purpose: Hoeren content is not yet in the database, so an
  // attempt whose content_revision names no Modelltest (e.g. the historic
  // mock-horen-* rows) genuinely belongs to no exam.
  modelltest_id         String?            @db.Uuid
  listening_exercise_id String?            @db.Uuid
  listening_exercise    ListeningExercise? @relation(fields: [listening_exercise_id], references: [id], onDelete: Restrict)

  @@index([listening_exercise_id])
  @@map("listening_attempts")
}

model NewsletterSubscriber {
  id              String   @id @default(uuid())
  email           String   @unique
  full_name       String
  consent_version String
  consented_at    DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model SprachbausteineAttempt {
  attempt_id       String    @id @default(uuid())
  student_id       String
  teil_id          String
  modelltest_id    String?
  status           String    @default("completed")
  score            Int?
  feedback         String?
  answers          Json?
  content_revision String?
  duration_seconds Int?
  created_at       DateTime  @default(now())
  completed_at     DateTime?

  @@index([student_id, teil_id])
  @@map("sprachbausteine_attempts")
}

model LesenPassage {
  id         String    @id @default(uuid())
  title      String
  content    String
  cefr_level String    @default("B1")
  topic      String?
  word_count Int?
  created_at DateTime? @default(now())

  questions LesenQuestion[]

  @@map("lesen_passages")
}

model LesenQuestion {
  id             String    @id @default(uuid())
  passage_id     String
  question_text  String
  question_type  String
  options        Json
  correct_answer String
  explanation    String?
  difficulty     Int?
  created_at     DateTime? @default(now())

  passage LesenPassage @relation(fields: [passage_id], references: [id])

  @@map("lesen_questions")
}

model LesenSession {
  session_id   String    @id @default(uuid())
  user_id      String?
  student_id   String?
  question_ids String[]
  status       String
  started_at   DateTime? @default(now())
  completed_at DateTime?

  student Student?      @relation(fields: [student_id], references: [id])
  results LesenResult[]

  @@map("lesen_sessions")
}

model LesenResult {
  id              String    @id @default(uuid())
  session_id      String
  user_answers    Json
  score           Float
  correct_count   Int
  total_questions Int
  created_at      DateTime? @default(now())

  session LesenSession @relation(fields: [session_id], references: [session_id])

  @@map("lesen_results")
}

model LesenTeil2Exercise {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentRevision String
  label           String
  instruction     String
  cautionNote     String
  topSender       String
  topReceiver     String
  topBody         String
  quotedThread    String
  createdAt       DateTime @default(now())

  questions LesenTeil2Question[]

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("lesen_teil2_exercises")
}

model LesenTeil2Question {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId     String @db.Uuid
  questionNumber Int
  prompt         String
  sortOrder      Int

  exercise LesenTeil2Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  options  LesenTeil2Option[]

  @@map("lesen_teil2_questions")
}

model LesenTeil2Option {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String  @db.Uuid
  content    String
  isCorrect  Boolean @default(false)
  sortOrder  Int

  question LesenTeil2Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("lesen_teil2_options")
}

model SprachbausteineExercise {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teil_number      Int
  content_revision String
  label            String?
  instruction      String
  duration_minutes Int
  image_url        String
  body             String
  created_at       DateTime @default(now())

  gaps SprachbausteineGap[]

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("sprachbausteine_exercises")
}

model SprachbausteineGap {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercise_id String @db.Uuid
  gap_key     String
  gap_number  Int
  sort_order  Int

  exercise SprachbausteineExercise    @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  options  SprachbausteineGapOption[]

  @@unique([exercise_id, gap_key])
  @@map("sprachbausteine_gaps")
}

model SprachbausteineGapOption {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gap_id     String  @db.Uuid
  content    String
  is_correct Boolean @default(false)
  sort_order Int

  gap SprachbausteineGap @relation(fields: [gap_id], references: [id], onDelete: Cascade)

  @@map("sprachbausteine_gap_options")
}

model SprachbausteineTeil2Exercise {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentRevision String
  label           String
  instruction     String
  durationMinutes Int
  imageUrl        String   @map("image_url")
  body            String
  createdAt       DateTime @default(now())

  words SprachbausteineTeil2Word[]
  gaps  SprachbausteineTeil2Gap[]

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("sprachbausteine_teil2_exercises")
}

model SprachbausteineTeil2Word {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId String @db.Uuid
  letter     String
  content    String
  sortOrder  Int

  exercise SprachbausteineTeil2Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  gaps     SprachbausteineTeil2Gap[]

  @@map("sprachbausteine_teil2_words")
}

model SprachbausteineTeil2Gap {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId    String @db.Uuid
  gapKey        String
  gapNumber     Int
  correctWordId String @db.Uuid
  sortOrder     Int

  exercise    SprachbausteineTeil2Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  correctWord SprachbausteineTeil2Word     @relation(fields: [correctWordId], references: [id], onDelete: Restrict)

  @@unique([exerciseId, gapKey])
  @@map("sprachbausteine_teil2_gaps")
}

model LesenTeil1Exercise {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentRevision String
  label           String
  instruction     String
  createdAt       DateTime @default(now())

  texts  LesenTeil1Text[]
  titles LesenTeil1Title[]

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("lesen_teil1_exercises")
}

model LesenTeil1Text {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId     String  @db.Uuid
  textNumber     Int
  von            String?
  an             String?
  body           String
  sortOrder      Int
  correctTitleId String  @db.Uuid

  exercise     LesenTeil1Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  correctTitle LesenTeil1Title    @relation("CorrectTitle", fields: [correctTitleId], references: [id])

  @@map("lesen_teil1_texts")
}

model LesenTeil1Title {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId String @db.Uuid
  content    String
  sortOrder  Int

  exercise   LesenTeil1Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  correctFor LesenTeil1Text[]   @relation("CorrectTitle")

  @@map("lesen_teil1_titles")
}

model LesenTeil3Exercise {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentRevision String
  label           String
  instruction     String
  createdAt       DateTime @default(now())

  situations    LesenTeil3Situation[]
  announcements LesenTeil3Announcement[]

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("lesen_teil3_exercises")
}

model LesenTeil3Announcement {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId String @db.Uuid
  title      String
  content    String
  sortOrder  Int

  exercise   LesenTeil3Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  situations LesenTeil3Situation[]

  @@map("lesen_teil3_announcements")
}

model LesenTeil3Situation {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId            String  @db.Uuid
  situationNumber       Int
  content               String
  noMatch               Boolean @default(false)
  correctAnnouncementId String? @db.Uuid
  sortOrder             Int

  exercise            LesenTeil3Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  correctAnnouncement LesenTeil3Announcement? @relation(fields: [correctAnnouncementId], references: [id], onDelete: Restrict)

  @@map("lesen_teil3_situations")
}

model Modelltest {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number Int    @unique
  title  String

  // timestamptz(6), not Prisma's default timestamp(3): this table was created
  // by a hand-written SQL migration (007) that used TIMESTAMPTZ. Declared here
  // so the schema describes the database rather than drifting from it.
  created_at DateTime @default(now()) @db.Timestamptz(6)

  sprachbausteineExercises      SprachbausteineExercise[]
  sprachbausteineTeil2Exercises SprachbausteineTeil2Exercise[]
  lesenTeil1Exercises           LesenTeil1Exercise[]
  lesenTeil2Exercises           LesenTeil2Exercise[]
  lesenTeil3Exercises           LesenTeil3Exercise[]
  writingExercises              WritingExercise[]
  listeningExercises            ListeningExercise[]
  speakingExercises             SpeakingExercise[]

  @@map("modelltests")
}

model ListeningExercise {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelltest_id       String   @db.Uuid
  part                Int
  title               String
  subtitle            String?
  instruction         String
  content_revision    String   @unique
  duration_minutes    Int
  audio_url           String   @default("")
  bundled_audio_asset String   @default("")
  image_url           String
  transcript          String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  modelltest Modelltest          @relation(fields: [modelltest_id], references: [id], onDelete: Restrict)
  questions  ListeningQuestion[]
  attempts   ListeningAttempt[]

  @@unique([modelltest_id, part])
  @@index([modelltest_id])
  @@map("listening_exercises")
}

model ListeningQuestion {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercise_id     String @db.Uuid
  question_number Int
  prompt          String
  correct_answer  String
  sort_order      Int

  exercise ListeningExercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@unique([exercise_id, question_number])
  @@unique([exercise_id, sort_order])
  @@index([exercise_id])
  @@map("listening_questions")
}

model SpeakingExercise {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelltest_id         String   @db.Uuid
  part                  Int
  title                 String
  subtitle              String?
  topic_title           String
  topic_description     String
  topic_points          Json
  instructions          String
  duration_minutes      Int
  prep_duration_seconds Int
  image_url             String
  exam_image_url        String?
  content_revision      String   @unique
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  modelltest Modelltest @relation(fields: [modelltest_id], references: [id], onDelete: Restrict)

  @@unique([modelltest_id, part])
  @@index([modelltest_id])
  @@map("speaking_exercises")
}

model WritingExercise {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_revision  String
  title             String
  subtitle          String?
  task_type         String
  intro             String?
  stimulus          Json?
  task_instructions String
  bullet_points     String[] @default([])
  closing_reminder  String?
  // See Modelltest.created_at — same hand-written-migration origin.
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("writing_exercises")
}
