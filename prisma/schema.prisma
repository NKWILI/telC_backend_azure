generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum CenterPlan {
  TRIAL
  PAID
}

enum CenterUserRole {
  OWNER
  MANAGER
}

/// What a seat entitles its student to.
///
/// A trial is not a tier: it is an ordinary START seat priced at zero with a
/// 14-day clock, so trial and paid Start students behave identically
/// everywhere except the clock. That keeps the quota logic to three cases
/// rather than four.
enum Tier {
  START
  PRO
  PREMIUM
}

model Student {
  id           String   @id @default(uuid())
  first_name   String?
  last_name    String?
  email        String?  @unique
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  last_seen_at DateTime @default(now())

  password_hash              String?
  email_verified             Boolean   @default(false)
  email_verification_token   String?
  email_verification_expires DateTime?
  password_reset_token       String?
  password_reset_expires     DateTime?

  /// WhatsApp number. Optional, and the channel that actually reaches people
  /// in-market — email deliverability is the weaker of the two, which matters
  /// for renewal reminders and for reaching a student whose center lapses.
  phone String?

  /// One-time key a center hands to a student, hashed at rest exactly like the
  /// verification and reset tokens above. The raw key is shown to the center
  /// once, at generation, and cannot be recovered afterwards.
  activation_key_hash    String?
  activation_key_expires DateTime?
  /// When the student redeemed their key and chose a password. Distinguishes a
  /// provisioned-but-unused account from a real user, which reminders and any
  /// churn analysis need.
  activated_at           DateTime?
  /// Where that redemption came from. A center holds the key and can therefore
  /// redeem it itself, so this is the audit trail that makes an impersonation
  /// visible after the fact rather than preventing it.
  activated_ip           String?

  /// The center that provisioned this student, and the seat-counting boundary.
  /// Nullable: students who predate the center model, and any future
  /// independent student, simply have none.
  center_id String?

  /// Which tier this student's seat is, assigned by their center. Null for a
  /// student no center governs — anyone predating centers, and anyone removed
  /// from one. It decides what the student may do, so it is read per request.
  tier Tier?

  center          Center?         @relation(fields: [center_id], references: [id], onDelete: SetNull)
  ai_usage        AiUsage[]
  device_sessions DeviceSession[]
  exam_sessions   ExamSession[]
  lesen_sessions  LesenSession[]
  oauth_accounts  OAuthAccount[]

  @@index([center_id])
  @@index([activation_key_hash])

  @@index([email])
  @@map("students")
}

model OAuthAccount {
  id          String   @id @default(uuid())
  student_id  String
  provider    String
  provider_id String
  created_at  DateTime @default(now())

  student Student @relation(fields: [student_id], references: [id])

  @@unique([provider, provider_id])
  @@index([student_id])
  @@map("oauth_accounts")
}

model DeviceSession {
  id                 String    @id @default(uuid())
  student_id         String
  device_id          String
  refresh_token_hash String
  device_name        String?
  last_used_at       DateTime  @default(now())
  created_at         DateTime  @default(now())
  revoked_at         DateTime?

  student Student @relation(fields: [student_id], references: [id])

  @@unique([student_id, device_id])
  @@index([student_id])
  @@map("device_sessions")
}

model Center {
  id   String @id @default(uuid())
  /// The only thing registration collects about the center itself, so it stays
  /// required — optional here would let a five-field signup write a row that
  /// says nothing.
  name String

  /// The first, free-text pair, kept only until every row has moved to the
  /// structured columns below. Nothing new writes them; they are dropped in a
  /// migration of their own once production is checked, because a column drop
  /// is not something to ride along with the feature that replaces it.
  country    String?
  city       String?
  logo_url   String?

  /// Where the school is, as ids rather than prose.
  ///
  /// A controlled country decides the address rules, the currency and later
  /// the tax; free text would give back "Douala / douala / Dla", which no
  /// report can group. Collected during onboarding rather than at
  /// registration, so all of it is nullable until a center completes its
  /// profile.
  country_code String?
  /// Never supplied by a client: it is looked up from the chosen city, so a
  /// city can never end up filed under a region it does not belong to.
  region_id    String?
  /// The city we list, or…
  city_id      String?
  /// …the one we do not. A school in a town missing from the list types it
  /// here and is never blocked from onboarding; a name typed often enough is
  /// promoted into the list, and these rows repointed.
  city_other   String?

  /// The rest of the address, required or not depending on the country: a
  /// quarter is how an address is given in Cameroon, while Germany needs
  /// street, number and postal code. The rule lives beside the country list,
  /// not here — a column cannot express "required only for CM".
  district     String?
  postal_code  String?
  street       String?
  house_number String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt


  users            CenterUser[]
  activation_codes ActivationCode[]
  payments         Payment[]
  seats        CenterSeat[]
  students     Student[]
  subscription CenterSubscription?

  @@map("centers")
}

/// One per center, created with the center so a center without a subscription
/// is a bug rather than a supported state.
///
/// There is no `status` column on purpose. A stored status has to be kept
/// correct by a scheduled job, and when that job runs late the failure
/// direction is granting access nobody paid for. These timestamps are the
/// facts; `SubscriptionPolicyService` derives the status from them on read.
model CenterSubscription {
  id         String     @id @default(uuid())
  center_id  String     @unique
  plan       CenterPlan @default(TRIAL)

  /// Set by the first student activation (Phase 4), not at registration.
  trial_started_at DateTime?
  trial_ends_at    DateTime?
  /// Set by verified payment (Phase 7). Grace is derived from it, and applies
  /// only to a lapsed paid period — an expired trial blocks immediately.
  paid_until       DateTime?

  created_at DateTime   @default(now())
  updated_at DateTime   @default(now()) @updatedAt

  center Center @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@map("center_subscriptions")
}

/// The seats a center holds in one tier.
///
/// One row per tier, so a seat count never depends on remembering to sum
/// several rows. A center may hold all three tiers at once — five Start,
/// three Pro and two Premium is a valid arrangement.
/// A chargeable AI operation, one value per thing a quota is counted against.
///
/// An enum rather than free text so a typo cannot silently create a new
/// category that no allowance covers. Only speaking is metered today; Premium's
/// "AI in every module" adds values here, and each new value needs an
/// allowance before it is written.
enum AiOperation {
  SPEAKING_EVALUATION
}

model CenterSeat {
  id        String @id @default(uuid())
  center_id String
  tier      Tier
  /// Seats held in this tier. Never zero: a row saying "no seats" is not the
  /// same as no row, and would make every count ambiguous.
  quantity  Int

  /// The price this center pays for this tier, copied in at purchase rather
  /// than looked up. This is what makes grandfathering automatic — raising the
  /// list price later cannot rewrite what a center already agreed to.
  ///
  /// Zero is legal, and is how a free trial seat is held.
  unit_price_xaf Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  center Center @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@unique([center_id, tier])
  @@map("center_seats")
}

/// Where an activation code stands.
///
/// `ACTIVATED` is a code waiting for a student, `CONNECTED` one a student has
/// redeemed, `DEACTIVATED` one the center has taken back. There is no
/// `EXPIRED`: expiry is a date compared on read, so a code cannot sit in the
/// wrong state because no job ran.
enum ActivationCodeStatus {
  ACTIVATED
  CONNECTED
  DEACTIVATED
}

/// One seat, as a value a center can hand to a student.
///
/// Created only by the backend — a trial starting, or a payment succeeding —
/// so the number of codes and the number of seats paid for cannot disagree.
/// There is no route that makes one by hand.
model ActivationCode {
  id        String @id @default(uuid())
  center_id String
  /// `LQ-XXXX-XXXX`, stored readable rather than hashed: a manager has to see
  /// it again on the Users page to hand it out. Deactivation, not secrecy, is
  /// what protects a seat.
  code      String @unique
  /// Which plan the seat entitles its student to. A trial seat is START at
  /// zero price, so the trial needs no tier of its own.
  tier      Tier

  status ActivationCodeStatus @default(ACTIVATED)

  /// The student who redeemed it, and what they were called at that moment.
  /// Name and email are copied rather than joined so the center still sees who
  /// held a seat after the student is gone; the id is the link that matters.
  student_id    String?
  linked_name   String?
  linked_email  String?
  connected_at  DateTime?
  /// Where the redemption came from. A center holds the code and can redeem it
  /// itself, so this is the audit trail that makes that visible afterwards.
  connected_ip  String?

  /// When the seat stops working, compared on read. Null means it follows the
  /// center's subscription rather than a date of its own — which is what paid
  /// codes do until D4 says otherwise.
  expires_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  center Center @relation(fields: [center_id], references: [id], onDelete: Cascade)

  /// The Users page lists a center's codes by state; redemption looks one up
  /// by its value, which the unique index above already covers.
  events ActivationCodeEvent[]

  @@index([center_id, status])
  @@index([student_id])
  @@map("activation_codes")
}

/// Every change a center makes to one of its codes.
///
/// Append-only. It answers "who cut this student off, and when" after the
/// fact, and it is the count behind any future limit on how often one seat may
/// move between students — without it, a school could rotate one paid seat
/// through a whole class and nothing would show it.
model ActivationCodeEvent {
  id              String               @id @default(uuid())
  code_id         String
  center_id       String
  /// The manager who acted. Null would mean the system acted; nothing does yet.
  center_user_id  String?
  from_status     ActivationCodeStatus
  to_status       ActivationCodeStatus
  /// Who held the seat at that moment, so a deactivation still names the
  /// student it cut off after the code has been handed to someone else.
  student_id      String?
  created_at      DateTime             @default(now())

  code ActivationCode @relation(fields: [code_id], references: [id], onDelete: Cascade)

  @@index([code_id, created_at])
  @@map("activation_code_events")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

/// A center's intent to pay for seats.
///
/// Nothing here grants access. Only a verified provider event may move
/// `paid_until` (Phase 7), which is why `SUCCEEDED` exists in the enum from
/// the start but is never written in this phase — Phase 7 needs somewhere to
/// put a verified result without another migration.
model Payment {
  id        String @id @default(uuid())
  center_id String

  /// Seats across every tier in this payment. A convenience total; the
  /// authoritative per-tier figures live in `lines`.
  total_seats Int
  /// What the whole payment comes to, snapshotted at creation. A price change
  /// next year must not rewrite what a center agreed to this year, so this is
  /// a copy rather than a join back to today's prices.
  amount_xaf  Int

  status PaymentStatus @default(PENDING)

  /// The payment provider's own id for this transaction, stored when a
  /// checkout starts. A webhook finds its payment by this, and it is unique so
  /// one provider transaction can never be applied to two payments. Null until
  /// a checkout exists; Postgres allows any number of nulls under a unique
  /// index.
  provider_reference String?   @unique
  /// Where the center is sent to pay, stored with the reference. A repeated or
  /// double-clicked checkout returns this instead of asking the provider
  /// again, which would open a second provider transaction for one payment.
  checkout_url       String?
  /// When activation granted access. Set once, by the same statement that
  /// moves the status, so the two can never disagree.
  succeeded_at       DateTime?
  /// When the provider reported the payment failed. A later success still
  /// activates — the provider is the authority on whether money moved.
  failed_at          DateTime?

  /// Supplied by the client and claimed atomically by the unique index below.
  /// The index is the concurrency control: two simultaneous requests race to
  /// insert, one wins, and the loser is answered from the row that won.
  idempotency_key String
  /// Fingerprint of the request the key was first used with. A replay carrying
  /// the same key but different seats is a different intent wearing the same
  /// name, and is refused rather than handed the original record.
  request_hash    String

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  center Center        @relation(fields: [center_id], references: [id], onDelete: Cascade)
  lines  PaymentLine[]

  @@unique([center_id, idempotency_key])
  @@index([center_id, created_at])
  @@map("payments")
}

/// One tier within a payment.
///
/// A payment can cover several tiers at different prices, so the breakdown
/// cannot live in a single pair of columns on the payment. Each line carries
/// the price that applied at the time, which is what keeps an old invoice
/// truthful after the list price moves.
model PaymentLine {
  id         String @id @default(uuid())
  payment_id String
  tier       Tier
  seats      Int

  unit_price_xaf Int
  /// Always seats * unit_price_xaf, and a CHECK constraint enforces it. The
  /// column is stored rather than computed so an invoice keeps its own total
  /// even if the arithmetic here ever changes.
  amount_xaf     Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@unique([payment_id, tier])
  @@map("payment_lines")
}

model CenterUser {
  id           String         @id @default(uuid())
  center_id    String
  role         CenterUserRole @default(OWNER)
  first_name   String
  last_name    String
  email        String         @unique
  /// The manager's own number, not the school's public line, and collected
  /// during onboarding rather than at registration. Nullable for that reason.
  /// This is who gets contacted about a late payment or a locked account.
  phone        String?

  /// Where the manager is, which is not necessarily where the school is — a
  /// chain's owner may sit in Yaoundé while the school is in Douala. Same
  /// three columns as the center, and the same rule: the region is derived
  /// from the city, never sent by a client. No address fields: nothing is
  /// posted to a manager.
  country_code String?
  region_id    String?
  city_id      String?
  city_other   String?
  created_at   DateTime       @default(now())
  updated_at   DateTime       @default(now()) @updatedAt
  last_seen_at DateTime       @default(now())

  password_hash              String
  email_verified             Boolean   @default(false)
  email_verification_token   String?
  email_verification_expires DateTime?
  password_reset_token       String?
  password_reset_expires     DateTime?

  center          Center                @relation(fields: [center_id], references: [id], onDelete: Restrict)
  device_sessions CenterDeviceSession[]

  @@index([center_id])
  @@index([email_verification_token])
  @@index([password_reset_token])
  @@map("center_users")
}

model CenterDeviceSession {
  id                 String    @id @default(uuid())
  center_user_id     String
  device_id          String
  refresh_token_hash String
  device_name        String?
  last_used_at       DateTime  @default(now())
  created_at         DateTime  @default(now())
  revoked_at         DateTime?

  center_user CenterUser @relation(fields: [center_user_id], references: [id], onDelete: Cascade)

  @@unique([center_user_id, device_id])
  @@index([center_user_id])
  @@map("center_device_sessions")
}

model ExamSession {
  session_id                 String    @id @default(uuid())
  user_id                    String?
  student_id                 String?
  teil_number                Int
  status                     String
  use_timer                  Boolean?  @default(true)
  time_limit_seconds         Int?
  server_start_time          DateTime?
  pause_timestamp            DateTime?
  elapsed_time               Int?      @default(0)
  context_from_previous_teil Boolean?  @default(false)
  created_at                 DateTime? @default(now())
  updated_at                 DateTime? @default(now())
  completed_at               DateTime?

  student          Student?         @relation(fields: [student_id], references: [id])
  teil_transcripts TeilTranscript[]
  teil_evaluations TeilEvaluation[]
  gemini_sessions  GeminiSession[]

  @@map("exam_sessions")
}

model GeminiSession {
  id                String    @id @default(uuid())
  exam_session_id   String
  gemini_session_id String?
  status            String?
  created_at        DateTime? @default(now())
  closed_at         DateTime?
  error_message     String?

  exam_session ExamSession @relation(fields: [exam_session_id], references: [session_id])

  @@map("gemini_sessions")
}

model TeilTranscript {
  id                   String    @id @default(uuid())
  session_id           String
  transcript_text      String
  conversation_history Json?
  word_count           Int?      @default(0)
  interrupted_at       DateTime?
  created_at           DateTime? @default(now())

  exam_session ExamSession @relation(fields: [session_id], references: [session_id])

  @@map("teil_transcripts")
}

model TeilEvaluation {
  id                      String    @id @default(uuid())
  session_id              String
  pronunciation_score     Float?
  fluency_score           Float?
  grammar_score           Float?
  vocabulary_score        Float?
  overall_score           Float?
  corrections_json        Json?
  strengths               String?
  areas_for_improvement   String?
  evaluation_requested_at DateTime?
  created_at              DateTime? @default(now())

  exam_session ExamSession @relation(fields: [session_id], references: [session_id])

  @@map("teil_evaluations")
}

model WritingAttempt {
  attempt_id        String    @id @default(uuid())
  student_id        String
  exercise_id       String
  modelltest_id     String?   @db.Uuid
  content           String
  status            String    @default("pending")
  score             Int?
  feedback          String?
  corrected_text    String?
  corrections       Json?
  diff              Json?
  points_addressed  Int?
  duration_seconds  Int?
  notification_sent Boolean   @default(false)
  created_at        DateTime  @default(now())
  completed_at      DateTime?

  @@map("writing_attempts")
}

model ListeningAttempt {
  attempt_id       String    @id @default(uuid())
  student_id       String
  exercise_id      String
  status           String    @default("completed")
  score            Int?
  feedback         String?
  duration_seconds Int?
  content_revision String?
  timed            Boolean?
  created_at       DateTime  @default(now())
  completed_at     DateTime?

  // Column only, no relation — matches WritingAttempt and SprachbausteineAttempt.
  // Nullable on purpose: Hoeren content is not yet in the database, so an
  // attempt whose content_revision names no Modelltest (e.g. the historic
  // mock-horen-* rows) genuinely belongs to no exam.
  modelltest_id         String?            @db.Uuid
  listening_exercise_id String?            @db.Uuid
  listening_exercise    ListeningExercise? @relation(fields: [listening_exercise_id], references: [id], onDelete: Restrict)

  @@index([listening_exercise_id])
  @@map("listening_attempts")
}

model NewsletterSubscriber {
  id              String   @id @default(uuid())
  email           String   @unique
  full_name       String
  consent_version String
  consented_at    DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model SprachbausteineAttempt {
  attempt_id       String    @id @default(uuid())
  student_id       String
  teil_id          String
  modelltest_id    String?
  status           String    @default("completed")
  score            Int?
  feedback         String?
  answers          Json?
  content_revision String?
  duration_seconds Int?
  created_at       DateTime  @default(now())
  completed_at     DateTime?

  @@index([student_id, teil_id])
  @@map("sprachbausteine_attempts")
}

model LesenPassage {
  id         String    @id @default(uuid())
  title      String
  content    String
  cefr_level String    @default("B1")
  topic      String?
  word_count Int?
  created_at DateTime? @default(now())

  questions LesenQuestion[]

  @@map("lesen_passages")
}

model LesenQuestion {
  id             String    @id @default(uuid())
  passage_id     String
  question_text  String
  question_type  String
  options        Json
  correct_answer String
  explanation    String?
  difficulty     Int?
  created_at     DateTime? @default(now())

  passage LesenPassage @relation(fields: [passage_id], references: [id])

  @@map("lesen_questions")
}

model LesenSession {
  session_id   String    @id @default(uuid())
  user_id      String?
  student_id   String?
  question_ids String[]
  status       String
  started_at   DateTime? @default(now())
  completed_at DateTime?

  student Student?      @relation(fields: [student_id], references: [id])
  results LesenResult[]

  @@map("lesen_sessions")
}

model LesenResult {
  id              String    @id @default(uuid())
  session_id      String
  user_answers    Json
  score           Float
  correct_count   Int
  total_questions Int
  created_at      DateTime? @default(now())

  session LesenSession @relation(fields: [session_id], references: [session_id])

  @@map("lesen_results")
}

model LesenTeil2Exercise {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentRevision String
  label           String
  instruction     String
  cautionNote     String
  topSender       String
  topReceiver     String
  topBody         String
  quotedThread    String
  createdAt       DateTime @default(now())

  questions LesenTeil2Question[]

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("lesen_teil2_exercises")
}

model LesenTeil2Question {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId     String @db.Uuid
  questionNumber Int
  prompt         String
  sortOrder      Int

  exercise LesenTeil2Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  options  LesenTeil2Option[]

  @@map("lesen_teil2_questions")
}

model LesenTeil2Option {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String  @db.Uuid
  content    String
  isCorrect  Boolean @default(false)
  sortOrder  Int

  question LesenTeil2Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("lesen_teil2_options")
}

model SprachbausteineExercise {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teil_number      Int
  content_revision String
  label            String?
  instruction      String
  duration_minutes Int
  image_url        String
  body             String
  created_at       DateTime @default(now())

  gaps SprachbausteineGap[]

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("sprachbausteine_exercises")
}

model SprachbausteineGap {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercise_id String @db.Uuid
  gap_key     String
  gap_number  Int
  sort_order  Int

  exercise SprachbausteineExercise    @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  options  SprachbausteineGapOption[]

  @@unique([exercise_id, gap_key])
  @@map("sprachbausteine_gaps")
}

model SprachbausteineGapOption {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gap_id     String  @db.Uuid
  content    String
  is_correct Boolean @default(false)
  sort_order Int

  gap SprachbausteineGap @relation(fields: [gap_id], references: [id], onDelete: Cascade)

  @@map("sprachbausteine_gap_options")
}

model SprachbausteineTeil2Exercise {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentRevision String
  label           String
  instruction     String
  durationMinutes Int
  imageUrl        String   @map("image_url")
  body            String
  createdAt       DateTime @default(now())

  words SprachbausteineTeil2Word[]
  gaps  SprachbausteineTeil2Gap[]

  modelltest_id String     @db.Uuid
  modelltest    Modelltest @relation(fields: [modelltest_id], references: [id])

  @@unique([modelltest_id])
  @@map("sprachbausteine_teil2_exercises")
}

model SprachbausteineTeil2Word {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId String @db.Uuid
  letter     String
  content    String
  sortOrder  Int

  exercise SprachbausteineTeil2Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  gaps     SprachbausteineTeil2Gap[]

