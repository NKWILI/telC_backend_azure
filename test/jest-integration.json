{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "roots": [
    "<rootDir>/src",
    "<rootDir>/test"
  ],
  "testRegex": ".*-integration\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "testEnvironment": "node",
  "maxWorkers": 1,
  "setupFiles": [
    "<rootDir>/test/jest-integration-setup.ts"
  ],
  "testTimeout": 60000
}
