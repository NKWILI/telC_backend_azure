# Database — Neon pooled connection (used by Prisma at runtime)
DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@ep-xxx-pooler.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Database — Neon direct connection (used by prisma migrate — non-pooler URL)
DIRECT_DATABASE_URL=postgresql://neondb_owner:[PASSWORD]@ep-xxx.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Google Generative AI
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the Gemini text model used for writing correction and speaking evaluation.
# Defaults to 'gemini-2.0-flash' (NOT in the free tier as of 2025-2026).
# For free-tier usage set this to 'gemini-1.5-flash'.
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Writing-correction model provider: 'gemini' (default) or 'grok'
MODEL_PROVIDER=gemini

# xAI Grok API config (only used when MODEL_PROVIDER=grok)
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-latest

# Email Service
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com   # must be a verified sender in your Resend account

# Authentication — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Generate each secret independently; never reuse the same value.
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# DigitalOcean Managed Valkey (TLS connection URI, keep secret)
VALKEY_URL=rediss://default:password@private-host:25061
RATE_LIMIT_LOGIN_IP_MAX_ATTEMPTS=20
RATE_LIMIT_LOGIN_EMAIL_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# Token hashing — HMAC key for verification and reset tokens
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
TOKEN_HMAC_SECRET=

# Google OAuth — Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Frontend URL — used in password-reset email links and as the
# verification-link fallback when VITRINE_URL is unset.
FRONTEND_URL=https://your-flutter-web-url.com

# Vitrine (marketing site) URL — target for verification email links so a
# user clicking from any device lands on the public success/fail page.
# If unset, verification links fall back to FRONTEND_URL.
VITRINE_URL=https://sprach-tau.vercel.app

# Server Configuration
PORT=3000

# Rate limits — overrides for the in-memory rate limiter (optional, defaults shown)
# RATE_LIMIT_FORGOT_PASSWORD_MAX_ATTEMPTS=5
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MINUTES=15
# RATE_LIMIT_RESET_PASSWORD_MAX_ATTEMPTS=20
# RATE_LIMIT_RESET_PASSWORD_WINDOW_MINUTES=15
# RATE_LIMIT_VERIFY_EMAIL_PUBLIC_MAX_ATTEMPTS=10
# RATE_LIMIT_VERIFY_EMAIL_PUBLIC_WINDOW_MINUTES=15
# RATE_LIMIT_NEWSLETTER_IP_MAX_ATTEMPTS=5
# RATE_LIMIT_NEWSLETTER_IP_WINDOW_MINUTES=15
# RATE_LIMIT_NEWSLETTER_EMAIL_MAX_ATTEMPTS=2
# RATE_LIMIT_NEWSLETTER_EMAIL_WINDOW_MINUTES=15

# Demo phase — guest session caps (per IP)
# RATE_LIMIT_GUEST_SESSION_MAX_ATTEMPTS=10
# RATE_LIMIT_GUEST_SESSION_WINDOW_MINUTES=60
# RATE_LIMIT_WRITING_GUEST_SUBMIT_MAX_ATTEMPTS=3
# RATE_LIMIT_WRITING_GUEST_SUBMIT_WINDOW_MINUTES=60

# POST /api/auth/register. The per-email cap is the security-relevant one:
# re-registering an address rotates its verification token, so without a cap
# anyone who knows the address can loop on it and the real owner's link dies
# before they can click it. Per-IP is looser on purpose — a class signing up
# together shares one NAT address.
# RATE_LIMIT_REGISTER_EMAIL_MAX_ATTEMPTS=5
# RATE_LIMIT_REGISTER_EMAIL_WINDOW_MINUTES=60
# RATE_LIMIT_REGISTER_IP_MAX_ATTEMPTS=20
# RATE_LIMIT_REGISTER_IP_WINDOW_MINUTES=60

# Max in-flight AI corrections (p-limit cap on writing-correction worker).
# Prevents bursts of submissions from exhausting Gemini rate limits.
# WRITING_CORRECTION_CONCURRENCY=5

# CORS — comma-separated list of allowed frontend origins.
# Must include the vitrine origin so its /verify-email page can POST to
# /api/auth/verify-email-public. Add Vercel preview origins as needed.
# Example: ALLOWED_ORIGINS=https://app.example.com,https://sprach-tau.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://sprach-tau.vercel.app
