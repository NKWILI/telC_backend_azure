meta {
  name: 06 Forgot password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/center-auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{centerEmail}}"
  }
}

assert {
  res.status: eq 201
}

docs {
  Send this twice: once with a registered address, once with one that does not
  exist. Both must return an identical body and status.

  A difference of any kind — body, status, or a noticeably different response
  time — is an account-enumeration oracle.

  The six-digit code is emailed. Copy it into `resetCode` for step 07. It is
  valid for ten minutes.
}
