meta {
  name: 07 Reset password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/center-auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{centerEmail}}",
    "code": "{{resetCode}}",
    "newPassword": "a-brand-new-password",
    "deviceId": "{{deviceId}}",
    "deviceName": "Bruno"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.accessToken);
  bru.setEnvVar("refreshToken", res.body.refreshToken);
}

docs {
  A reset revokes every existing center session and issues one for the device
  that performed it.

  To see that: log in on a second `deviceId` first and keep its access token.
  After the reset, that token must return 401 on `Get me`, while the token
  returned here still works.

  Then re-send this request with the same code — it must fail. The code is
  consumed by a predicated update, so it cannot be redeemed twice. Remember to
  update `centerPassword` afterwards or step 03 will fail.
}
